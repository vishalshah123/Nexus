# Copy to .env and set local values. Never commit .env.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Host-run API (Docker Compose uses the service DNS name internally)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/nexus
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-local-password
SERVER_PORT=9095

# Optional AI provider credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_GEMINI_API_KEY=
NEXUS_ANTHROPIC_API_KEY=

# Optional JWT validation (enable only after configuring a trusted issuer)
NEXUS_SECURITY_ENABLED=false
NEXUS_JWT_ISSUER_URI=http://localhost:8080/realms/i-system-realm
