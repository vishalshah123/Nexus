# Copy this file to .env and replace the password with a strong local value.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-strong-password

# Used when running the API directly on the host (outside Docker).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/nexus
SPRING_DATASOURCE_USERNAME=nexus
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password

SERVER_PORT=9095
